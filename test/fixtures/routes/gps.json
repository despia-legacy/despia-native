{
  "feature": "gps",
  "actions": {
    "start": {
      "scheme": "location://",
      "params": {
        "buffer": { "type": "integer", "min": 1, "description": "Seconds between points." },
        "movement": { "type": "integer", "min": 0, "description": "Movement threshold in centimetres." },
        "server": { "type": "string", "min": 1, "description": "POST each point to this URL." }
      }
    },
    "stop": {
      "scheme": "stoplocation://",
      "callback": ["locationSession"],
      "returns": "locationSession"
    }
  },
  "events": {
    "change": {
      "data": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "active": { "type": "boolean", "required": true },
          "latitude": { "type": "number", "required": true },
          "longitude": { "type": "number", "required": true }
        }
      }
    }
  }
}
